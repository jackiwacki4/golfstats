# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Access control for the private site -------------------------------------
# Required. The dashboard refuses to start without it unless HOST=127.0.0.1.
# Any non-empty string; you'll be prompted for it in the browser (user: anything).
DASHBOARD_PASSWORD=

# Where to bind. 127.0.0.1 = local only (default, safest).
# Set 0.0.0.0 only when deploying somewhere you intend to reach over a network.
HOST=127.0.0.1
PORT=8787

# --- Kalshi ------------------------------------------------------------------
# The scanner reads PUBLIC market data and needs no credentials at all.
# Fill these in only when you want portfolio-aware features and higher rate
# limits. See README "Getting Kalshi API keys".
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_KEY_ID=
# Path to the RSA private key .pem file Kalshi gave you. Path, not the key text.
KALSHI_PRIVATE_KEY_PATH=

# --- Cross-book consensus (optional but this is the strongest edge source) ----
# Free tier at https://the-odds-api.com (500 requests/month).
# Without it the consensus signal is skipped and the bot leans on the others.
ODDS_API_KEY=

# --- Bankroll & risk ---------------------------------------------------------
BANKROLL_DOLLARS=1000
# Fraction of full Kelly to actually stake. 0.25 is a sane, survivable default.
KELLY_FRACTION=0.25
# Minimum fee-adjusted edge (in probability points) before a bet is shown.
MIN_EDGE=0.03
