{
  "name": "kalshisportsbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private advisory bot that scans Kalshi for mispriced contracts and ranks the day's best bets by fee-adjusted edge.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "scan": "tsx src/cli.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "review": "tsx src/review.ts",
    "report": "tsx src/report.ts"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.3"
  }
}
